+from __future__ import annotations
+
+from langchain_core.prompts import ChatPromptTemplate
+
+from app.llm.report_guardrails import AUX_SYSTEM_PROMPT, extract_constraints
+
+
+class LangChainReportAssistant:
+    """Compose a tightly scoped auxiliary-generation prompt with LangChain.
+
+    The model receives only the already-confirmed conclusion and a read-only handling
+    direction. Internal diagnosis codes, confidence values, IP/MAC/VLAN/port identifiers
+    and the original report are deliberately not exposed to the model.
+
+    This keeps the LLM on the presentation layer: the deterministic diagnosis remains the
+    source of truth, and the generated sentence still has to pass application guardrails
+    before it can be appended to a report.
+    """
+
+    SAFE_FALLBACK_DIRECTION = "仅进行只读核查、人工复核、补充证据或转交授权维护人员。"
+
+    def __init__(self, backend) -> None:
+        self.backend = backend
+        self.prompt = ChatPromptTemplate.from_messages(
+            [
+                ("system", AUX_SYSTEM_PROMPT),
+                (
+                    "human",
+                    """根据下面已经确认的信息生成一句辅助说明。
+
+已确认结论：{conclusion}
+允许参考的处理方向：{recommendation}
+
+要求：
+- 只改写已有结论和处理方向，不要解释“为什么”，不得补充新的可能原因或根因。
+- 不得使用“无需其他操作”“已经完全确认”“可以排除其他问题”等超出已有证据的绝对化表述。
+- 不得输出任何内部字段、诊断代码、置信度、具体地址、设备编号、端口、VLAN编号或MAC。
+- 不得给出配置修改、设备操作或生产变更指令。
+- 证据或处理方向不足时，只能写“建议进一步只读核查/人工复核/转交授权人员”等保守表述。
+
+只输出一行：辅助说明：<最多80个中文字符的只读核查/人工复核/转交说明>。""",
+                ),
+            ]
+        )
+
+    def generate(self, source_report: str):
+        constraints = extract_constraints(source_report)
+        # Defense-in-depth: diagnosis_code/confidence/identifiers stay in the deterministic
+        # report and guardrail layer, but are not included in the LLM prompt.
+        prompt_value = self.prompt.invoke(
+            {
+                "conclusion": constraints.get("conclusion") or "当前证据不足，需要继续核查。",
+                "recommendation": constraints.get("recommendation") or self.SAFE_FALLBACK_DIRECTION,
+            }
+        )
+        messages: list[dict[str, str]] = []
+        for message in prompt_value.to_messages():
+            role = "system" if message.type == "system" else "user"
+            messages.append({"role": role, "content": str(message.content)})
+        result = self.backend.generate_chat(messages)
+        result.extra["prompt_framework"] = "langchain-chat-prompt-template"
+        result.extra["llm_input_scope"] = "confirmed-conclusion-and-readonly-direction-only"
+        return result
