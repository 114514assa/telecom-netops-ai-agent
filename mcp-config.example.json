{
  "mcpServers": {
    "telecom-netops-readonly": {
      "command": "python",
      "args": ["-m", "app.mcp_server"],
      "cwd": "/absolute/path/to/telecom-netops-ai-agent",
      "env": {
        "DATA_DIR": "data",
        "RUNTIME_DIR": "runtime",
        "RAG_ENABLED": "true",
        "OLLAMA_BASE_URL": "http://localhost:11434",
        "OLLAMA_EMBED_MODEL": "qwen3-embedding:0.6b"
      }
    }
  }
}
