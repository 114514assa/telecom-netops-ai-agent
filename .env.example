APP_ENV=development
HOST=0.0.0.0
PORT=8000

REQUIRE_APPROVAL=true

# RAG: tfidf works out of the box with public demo knowledge.
# Set vector after starting Ollama and building the FAISS index.
RAG_BACKEND=tfidf
RAG_KNOWLEDGE_DIR=knowledge/demo
RAG_TOP_K=3
RAG_VECTOR_FALLBACK_TO_TFIDF=true

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_TIMEOUT_SECONDS=120
VECTOR_INDEX_PATH=runtime/vector_index/knowledge.faiss
VECTOR_METADATA_PATH=runtime/vector_index/metadata.json

# Optional LLM
LLM_ENABLED=false
LLM_BACKEND=openai
LLM_BASE_URL=https://example.invalid/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# Optional local HF backend
LOCAL_LLM_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
LOCAL_LLM_QUANTIZATION=int4
LOCAL_LLM_DEVICE_MAP=auto
LOCAL_LLM_MAX_NEW_TOKENS=96
LOCAL_LLM_TEMPERATURE=0.0
LOCAL_LLM_TRUST_REMOTE_CODE=false
