# Safe local default; never expose an unauthenticated demo to a public network.
APP_ENV=development
HOST=
DEMO_AUTH_ENABLED=false
# For controlled demos set true and use two different, unpredictable values.
DEMO_READER_TOKEN=
DEMO_APPROVER_TOKEN=
# Reports require approval. This alone does not implement enterprise IAM.
PORT=

REQUIRE_APPROVAL=true

# RAG: LangChain OllamaEmbeddings + FAISS.
# Build the local index before enabling RAG in the running application.
RAG_ENABLED=true
RAG_KNOWLEDGE_DIR=
RAG_TOP_K=3
RAG_FAIL_OPEN=true

OLLAMA_BASE_URL=
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
VECTOR_INDEX_PATH=runtime/vector_index/knowledge.faiss
VECTOR_METADATA_PATH=runtime/vector_index/metadata.json

# Optional LLM
LLM_ENABLED=false
LLM_BACKEND=openai
LLM_BASE_URL=https://example.invalid/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# Optional local HF backend
LOCAL_LLM_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
LOCAL_LLM_QUANTIZATION=int4
LOCAL_LLM_DEVICE_MAP=auto
LOCAL_LLM_MAX_NEW_TOKENS=96
LOCAL_LLM_TEMPERATURE=0.0
LOCAL_LLM_TRUST_REMOTE_CODE=false

# PDF document input: 5 MiB / 20 pages / 30,000 text chars hard limits.
# No added API key: use existing DEMO_* tokens when DEMO_AUTH_ENABLED=true.
# PDF extraction requires pypdf and supports text-based PDFs only; no OCR.
